{
  "author": "tests",
  "description": "every action and condition",
  "name": "kitchen sink",
  "run": {
    "humanize": {
      "delay_ms": 25,
      "position_px": 3
    },
    "repeat": 3,
    "speed": 1.5,
    "start_delay_ms": 2000
  },
  "tags": [
    "fixture",
    "contract"
  ],
  "target_window": {
    "coordinates": "window",
    "pause_when_unfocused": false,
    "process": "notepad.exe",
    "title": "Notepad"
  },
  "timeline": [
    {
      "action": {
        "click": {
          "button": "right",
          "x": 100,
          "y": "{{ i * 10 }}"
        }
      },
      "at_ms": 0
    },
    {
      "action": {
        "double_click": {
          "button": "left",
          "x": 1,
          "y": 2
        }
      },
      "at_ms": 100
    },
    {
      "action": {
        "mouse_down": {
          "button": "middle",
          "x": 3,
          "y": 4
        }
      },
      "at_ms": 200
    },
    {
      "action": {
        "mouse_up": {
          "button": "middle",
          "x": 3,
          "y": 4
        }
      },
      "at_ms": 300
    },
    {
      "action": {
        "mouse_move": {
          "x": 1.5,
          "y": 6
        }
      },
      "at_ms": 400
    },
    {
      "action": {
        "drag": {
          "duration_ms": 250,
          "from_x": 1,
          "from_y": 2,
          "to_x": 3,
          "to_y": 4
        }
      },
      "at_ms": 500
    },
    {
      "action": {
        "scroll": {
          "delta_x": 0,
          "delta_y": -3
        }
      },
      "at_ms": 600
    },
    {
      "action": {
        "key_tap": {
          "key": "Space"
        }
      },
      "at_ms": 700
    },
    {
      "action": {
        "key_down": {
          "key": "Shift"
        }
      },
      "at_ms": 800
    },
    {
      "action": {
        "key_up": {
          "key": "Shift"
        }
      },
      "at_ms": 900
    },
    {
      "action": {
        "text_input": {
          "text": "hello {{ name }}"
        }
      },
      "at_ms": 1000
    },
    {
      "action": {
        "wait": {
          "ms": 500
        }
      },
      "at_ms": 1100
    },
    {
      "action": {
        "wait_until": {
          "condition": {
            "counter": {
              "key": "n",
              "op": "==",
              "value": 1
            }
          },
          "poll_interval_ms": 50,
          "timeout_ms": 5000
        }
      },
      "at_ms": 1200
    },
    {
      "action": {
        "conditional": {
          "condition": "always",
          "else_action": {
            "wait": {
              "ms": 1
            }
          },
          "then_action": "exit"
        }
      },
      "at_ms": 1300
    },
    {
      "action": {
        "set_counter": {
          "key": "i",
          "value": 0
        }
      },
      "at_ms": 1400
    },
    {
      "action": {
        "incr_counter": {
          "key": "i"
        }
      },
      "at_ms": 1500
    },
    {
      "action": {
        "decr_counter": {
          "key": "i"
        }
      },
      "at_ms": 1600
    },
    {
      "action": {
        "reset_counter": {
          "key": "i"
        }
      },
      "at_ms": 1700
    },
    {
      "action": "exit",
      "at_ms": 1800
    },
    {
      "action": {
        "call_macro": {
          "args": {
            "who": "{{ user }}"
          },
          "name": "login"
        }
      },
      "at_ms": 1900
    },
    {
      "action": {
        "wait_until": {
          "condition": {
            "window_focused": {
              "process": "notepad.exe",
              "title": "Notepad"
            }
          },
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3000
    },
    {
      "action": {
        "wait_until": {
          "condition": {
            "window_exists": {
              "process": "calc.exe",
              "title": "Calculator"
            }
          },
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3100
    },
    {
      "action": {
        "wait_until": {
          "condition": {
            "pixel_color": {
              "color": "#FF8800",
              "tolerance": 12,
              "x": 10,
              "y": 20
            }
          },
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3200
    },
    {
      "action": {
        "wait_until": {
          "condition": {
            "counter": {
              "key": "i",
              "op": ">=",
              "value": 3
            }
          },
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3300
    },
    {
      "action": {
        "wait_until": {
          "condition": "always",
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3400
    },
    {
      "action": {
        "wait_until": {
          "condition": "never",
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3500
    },
    {
      "action": {
        "wait_until": {
          "condition": {
            "and": [
              "always",
              "never"
            ]
          },
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3600
    },
    {
      "action": {
        "wait_until": {
          "condition": {
            "or": [
              "never",
              "always"
            ]
          },
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3700
    },
    {
      "action": {
        "wait_until": {
          "condition": {
            "not": {
              "condition": "always"
            }
          },
          "poll_interval_ms": 100
        }
      },
      "at_ms": 3800
    },
    {
      "action": {
        "wait": {
          "ms": 1
        }
      },
      "at_ms": 9000,
      "enabled": false,
      "note": "disabled on purpose"
    }
  ],
  "variables": {
    "user": {
      "default": "alice",
      "description": "who to log in as",
      "type": "string"
    }
  },
  "version": "1.0"
}
